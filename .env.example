# Global Configuration
VERIFY_SSL=true

# Destination DHIS2 Instance Configuration
DESTINATION_DHIS2_URL=https://destination-dhis2-instance.org
# Choose either Basic Auth or PAT (Personal Access Token)
DESTINATION_DHIS2_USERNAME=admin
DESTINATION_DHIS2_PASSWORD=district
# DESTINATION_DHIS2_PAT=your_destination_pat_token

# Partner 1: MZ-PATHFINDER Configuration
# If the source instance uses Basic Auth:
PATHFINDER_DHIS2_USERNAME=pathfinder_user
PATHFINDER_DHIS2_PASSWORD=pathfinder_password
# If the source instance uses Personal Access Token:
# PATHFINDER_DHIS2_PAT=your_pathfinder_pat_token

# Partner 2: MZ-PSI Configuration
# If the source instance uses Basic Auth:
PSI_DHIS2_USERNAME=psi_user
PSI_DHIS2_PASSWORD=psi_password
# If the source instance uses Personal Access Token:
# PSI_DHIS2_PAT=your_psi_pat_token
